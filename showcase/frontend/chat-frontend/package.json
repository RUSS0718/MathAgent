{
  "name": "mathagent-chat-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "vue-tsc -b",
    "build": "vue-tsc -b && vite build",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "check:deps": "node scripts/check-dependencies.mjs",
    "test:browser": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "check": "npm run check:deps && npm run typecheck && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@lucide/vue": "1.61.0",
    "katex": "0.19.0",
    "pinia": "3.0.4",
    "vue": "3.5.44",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-vue": "6.0.8",
    "typescript": "5.9.3",
    "vite": "8.1.6",
    "vue-tsc": "3.3.8"
  }
}
