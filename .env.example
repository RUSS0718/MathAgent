# Intern live Showcase configuration template
# Copy this file to `.env` and fill the key locally. Never commit `.env`.
INTERN_API_KEY=
INTERN_API_BASE=https://chat.intern-ai.org.cn/api/v1/chat/completions
INTERN_MODEL=intern-s2
INTERN_TIMEOUT_SECONDS=30
INTERN_RETRY_COUNT=1
INTERN_THINKING_MODE=true

# Showcase live only; these do not change the official user_agent budget.
SHOWCASE_INTERN_TIMEOUT_SECONDS=180
SHOWCASE_INTERN_RETRY_COUNT=2
SHOWCASE_INTERN_MAX_TOKENS=16384
SHOWCASE_PIPELINE_MAX_RUNTIME_SECONDS=1100
SHOWCASE_PIPELINE_MAX_MODEL_CALLS=6
SHOWCASE_PIPELINE_MAX_TOOL_CALLS=2
